# waybar

#config.jsonc
  "modules-left": ["custom/ws-left", "custom/workspaces", "custom/ws-right", "custom/ws-1", "custom/ws-2", "custom/ws-3", "custom/ws-4", "custom/tab-left", "custom/tab-right"],


"custom/workspaces": {
  "exec": "bash -lc 'while true; do cat /tmp/labwc_workspaces 2>/dev/null | tr -d \"\\r\\n\"; echo; sleep 0.5; done'",
  "return-type": "text",
  "interval": 0
},

"custom/ws-left": {
  "format": "<small>◀</small>",
"on-click": "bash -lc 'ws=$(tr -d \"\\r\\n\" < /tmp/labwc_workspaces 2>/dev/null || true); n=$(echo \"$ws\" | awk \"{print \\$2}\"); [ -z \"$n\" ] && n=3; nw=$(( (n+2)%4 + 1 )); wtype -M win -M Ctrl -P Left -s 500 -m win -m Ctrl -p Left >/dev/null 2>&1 || true; sleep 0.25; ~/.local/bin/labwc_ws_set \"$nw\"'",
  "tooltip": false,
  "interval": 0
},

"custom/ws-right": {
  "format": "<small>▶</small>",
"on-click": "bash -lc 'ws=$(tr -d \"\\r\\n\" < /tmp/labwc_workspaces 2>/dev/null || true); n=$(echo \"$ws\" | awk \"{print \\$2}\"); [ -z \"$n\" ] && n=3; nw=$(( (n)%4 + 1 )); wtype -M win -M Ctrl -P Right -s 500 -m win -m Ctrl -p Right >/dev/null 2>&1 || true; sleep 0.25; ~/.local/bin/labwc_ws_set \"$nw\"'",
  "tooltip": false,
  "interval": 0
},

  "custom/tab-left": {
    "format": "<small>◀</small>",
    "on-click": "bash -lc 'wtype -M Alt -M Shift -P Tab -m Alt -m Shift -p Tab >/dev/null 2>&1 || true'",
    "tooltip": false,
    "interval": 0
  },

  "custom/tab-right": {
    "format": "<small>▶</small>",
    "on-click": "bash -lc 'wtype -M Alt -P Tab -m Alt -p Tab >/dev/null 2>&1 || true'",
    "tooltip": false,
    "interval": 0
  },

  "custom/ws-1": {
    "format": " 1",
    "on-click": "bash -lc 'wtype -M win -P 1 -s 500 -m win -p 1 >/dev/null 2>&1 || true; printf \"%s\" \"Workspace 1\" > /tmp/labwc_workspaces'",
    "tooltip": false,
    "interval": 0
  },

  "custom/ws-2": {
    "format": " 2",
    "on-click": "bash -lc 'wtype -M win -P 2 -s 500 -m win -p 2 >/dev/null 2>&1 || true; printf \"%s\" \"Workspace 2\" > /tmp/labwc_workspaces'",
    "tooltip": false,
    "interval": 0
},

  "custom/ws-3": {
    "format": " 3",
    "on-click": "bash -lc 'wtype -M win -P 3 -s 500 -m win -p 3 >/dev/null 2>&1 || true; printf \"%s\" \"Workspace 3\" > /tmp/labwc_workspaces'",
    "tooltip": false,
    "interval": 0
  },

  "custom/ws-4": {
    "format": " 4",
    "on-click": "bash -lc 'wtype -M win -P 4 -s 500 -m win -p 4 >/dev/null 2>&1 || true; printf \"%s\" \"Workspace 4\" > /tmp/labwc_workspaces'",
    "tooltip": false,
    "interval": 0
  },

