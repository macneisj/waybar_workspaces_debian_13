# create these two files

# ws-step

#!/bin/bash
#~/.local/bin/ws-step
ws="$(tr -d '\r\n' < /tmp/labwc_workspaces 2>/dev/null || true)"

dir="${1:-left}"

if [ "$dir" = "right" ]; then
  if [ "$ws" = "Workspace 1" ]; then echo "Workspace 2" > /tmp/labwc_workspaces; fi
  if [ "$ws" = "Workspace 2" ]; then echo "Workspace 3" > /tmp/labwc_workspaces; fi
  if [ "$ws" = "Workspace 3" ]; then echo "Workspace 4" > /tmp/labwc_workspaces; fi
  if [ "$ws" = "Workspace 4" ]; then echo "Workspace 1" > /tmp/labwc_workspaces; fi
else
  if [ "$ws" = "Workspace 1" ]; then echo "Workspace 4" > /tmp/labwc_workspaces; fi
  if [ "$ws" = "Workspace 4" ]; then echo "Workspace 3" > /tmp/labwc_workspaces; fi
  if [ "$ws" = "Workspace 3" ]; then echo "Workspace 2" > /tmp/labwc_workspaces; fi
  if [ "$ws" = "Workspace 2" ]; then echo "Workspace 1" > /tmp/labwc_workspaces; fi
fi

# labwc_ws_set

#!/usr/bin/env bash
# ~/.local/bin/labwc_ws_set
printf "%s" "Workspace ${1}" > /tmp/labwc_workspaces

